; kernel.hasm — three processes, preempted, each with its own registers,
; and the third of them is the guard daemon.
;
; The book gives H-Kernel four responsibilities: process, memory, I/O, guard
; daemon. This is the fourth. HCHECK is defined there as the periodic half of
; a pair -- Guard catches a constraint inconsistency per operation, HCHECK
; catches bit flips and accumulated drift by re-validating full state on a
; schedule (Proposisi IIIH.3.2.1). The scheduling is what was missing, and a
; scheduler is what arrived last.
;
; ── the problem a context switch has to solve ────────────────────
; The handler starts running with the register file still holding the user's
; values. Saving them needs a base register, and setting up a base register
; destroys the value it was meant to save. There is no zero register here:
; MOVI R0, 7 puts 7 in R0.
;
; PUSH is the way out. It takes no base -- the stack pointer lives in hardware,
; not in a GPR -- so sixteen pushes get the whole file off the CPU without
; touching any of it.
;
; ── only sixteen, not eighteen ────────────────────────────────────
; The book names R0-R17 at §IIIJ.3.3.1, eighteen registers, and even gives
; R17 a role: link register, by software convention. But the instruction word
; it defines at §IIIF.3.3.1 gives DST/S1/S2 four bits each -- `[23:20]
; [19:16] [15:12]` -- which cannot name past 15. The book contradicts itself;
; nothing here builds the register it cannot address. R16 and R17 used to be
; nameable in .hasm text and silently aliased to R0/R1 (the assembler masked
; with `& 0xF` instead of checking), so this file's earlier draft pushed and
; popped eighteen "registers" that were really sixteen, twice pushing R0 and
; R1 under R16's and R17's names -- harmless only because a register pushed
; twice with nothing in between restores to the value it already had. The
; assembler refuses R16/R17 outright now, and this file saves the sixteen
; that exist.
;
; ── memory map ──────────────────────────────────────────────────
;   0x100-0x1FF  A's window      0x200-0x2FF  B's window
;   0x300-0x3FF  C's window      0xF00 pid    0xF01 ticks
;   0xF10 PCB[0]                 0xF30 PCB[1]     0xF50 PCB[2]
;
; PCB layout, in words from its base:
;   +0..+15  R0..R15        +16  pc        +17  mem_base   +18  mem_limit
;
; ── the three ───────────────────────────────────────────────────
;   A  counts by 1, never yields; only the timer takes it away
;   B  counts by 100 and yields by SYSCALL after each step
;   C  the guard daemon: HLOAD each of the 28 letters, HGRD it, count the
;      sweeps and count any failure. It never yields either -- a monitor that
;      has to be asked to run is not a monitor.
;
; A and B count in the same register, R1, by different strides, so B's total
; stays an exact multiple of 100 only if it never inherited one of A's steps.
; C makes that a three-way test rather than a two-way one.
;
; ── what is NOT saved ───────────────────────────────────────────
; The return-address stack is not part of a context. None of the three uses
; CALL, so nothing depends on it today, but a process that did would see
; another's return addresses. Recorded in cosmictera-build/OFF.md rather than
; left to be discovered.
;
; ── the two causes arrive differently ───────────────────────────
; A timer interrupt (cause 0) leaves epc at the NEXT instruction. A syscall
; (cause 5) leaves it AT the SYSCALL, because an exception names its own
; instruction, so the kernel advances it by one -- that single ADDI is what
; serving the call means.
;
; ── the timer is one-shot, and armed last on purpose ────────────
; `expired` is set by counter == compare, an equality rather than a threshold,
; and writing COMPARE also clears it. So one store both acknowledges the
; interrupt and sets the next deadline -- and WHERE that store sits decides
; whether the kernel works at all. It is the last thing dispatch does before
; handing the registers back, so the quantum is measured from the moment user
; code resumes rather than from when the handler started. Armed at the top
; instead, the deadline fell while the handler was still saving registers, and
; boot reaches dispatch without a trap, so nothing blocked it: the kernel
; trapped itself and wrote its own PC into a process block.
;
; 2047 and not 2048: the immediate is twelve bits SIGNED, so 2048 assembles to
; -2048 and the deadline lands in the past. The assembler took it without a
; word and the counter, being an equality, never matched again.

boot:
        MOVI  R5, 0
        MOVI  R1, vector
        CALL  hal_vector_set

; ── process A's block ─────────────────────────────────────────
        MOVI  R7, 0xF10
        MOVI  R1, 0
        STORE R1, R7, 0
        STORE R1, R7, 1
        STORE R1, R7, 2
        STORE R1, R7, 3
        STORE R1, R7, 4
        STORE R1, R7, 5
        STORE R1, R7, 6
        STORE R1, R7, 7
        STORE R1, R7, 8
        STORE R1, R7, 9
        STORE R1, R7, 10
        STORE R1, R7, 11
        STORE R1, R7, 12
        STORE R1, R7, 13
        STORE R1, R7, 14
        STORE R1, R7, 15
        MOVI  R1, procA
        STORE R1, R7, 16
        MOVI  R1, 0x100
        STORE R1, R7, 17
        MOVI  R1, 0x200
        STORE R1, R7, 18

; ── process B's block ─────────────────────────────────────────
        MOVI  R7, 0xF30
        MOVI  R1, 0
        STORE R1, R7, 0
        STORE R1, R7, 1
        STORE R1, R7, 2
        STORE R1, R7, 3
        STORE R1, R7, 4
        STORE R1, R7, 5
        STORE R1, R7, 6
        STORE R1, R7, 7
        STORE R1, R7, 8
        STORE R1, R7, 9
        STORE R1, R7, 10
        STORE R1, R7, 11
        STORE R1, R7, 12
        STORE R1, R7, 13
        STORE R1, R7, 14
        STORE R1, R7, 15
        MOVI  R1, procB
        STORE R1, R7, 16
        MOVI  R1, 0x200
        STORE R1, R7, 17
        MOVI  R1, 0x300
        STORE R1, R7, 18

; ── process C's block ─────────────────────────────────────────
        MOVI  R7, 0xF50
        MOVI  R1, 0
        STORE R1, R7, 0
        STORE R1, R7, 1
        STORE R1, R7, 2
        STORE R1, R7, 3
        STORE R1, R7, 4
        STORE R1, R7, 5
        STORE R1, R7, 6
        STORE R1, R7, 7
        STORE R1, R7, 8
        STORE R1, R7, 9
        STORE R1, R7, 10
        STORE R1, R7, 11
        STORE R1, R7, 12
        STORE R1, R7, 13
        STORE R1, R7, 14
        STORE R1, R7, 15
        MOVI  R1, procC
        STORE R1, R7, 16
        MOVI  R1, 0x300
        STORE R1, R7, 17
        MOVI  R1, 0x400
        STORE R1, R7, 18

        MOVI  R1, 0
        STORE R1, R5, 0xF01     ; ticks = 0
        MOVI  R1, 2
        STORE R1, R5, 0xF00     ; pid = 2, so the first dispatch wraps to 0

        MOVI  R1, 1             ; timer only. Syscall needs no bit: it is an
        CALL  hal_trap_enable   ; exception, and exceptions cannot be masked.
                                ; One bit buys preemption and yield.
        JMP   dispatch

; ── trap entry ──────────────────────────────────────────────────
; Sixteen pushes before anything else. Nothing above this line may use a
; register, because every register still belongs to the process.
vector:
        PUSH  R0
        PUSH  R1
        PUSH  R2
        PUSH  R3
        PUSH  R4
        PUSH  R5
        PUSH  R6
        PUSH  R7
        PUSH  R8
        PUSH  R9
        PUSH  R10
        PUSH  R11
        PUSH  R12
        PUSH  R13
        PUSH  R14
        PUSH  R15

; From here every register is scratch: the values are all on the stack.
        MOVI  R5, 0
        LOAD  R6, R5, 0xF00
        CALL  pcb_of            ; R6 -> R7

        CALL  hal_epc_get
        MOV   R8, R1
        CALL  hal_cause_get
        CMPI  R1, 5
        JNE   sv_st
        ADDI  R8, R8, 1         ; a syscall names its own instruction: serve it
sv_st:  STORE R8, R7, 16

; The stack gives them back newest first, so R15 comes off first. Only R0 is
; used as the landing register, so R7 survives all sixteen stores.
        POP   R0
        STORE R0, R7, 15
        POP   R0
        STORE R0, R7, 14
        POP   R0
        STORE R0, R7, 13
        POP   R0
        STORE R0, R7, 12
        POP   R0
        STORE R0, R7, 11
        POP   R0
        STORE R0, R7, 10
        POP   R0
        STORE R0, R7, 9
        POP   R0
        STORE R0, R7, 8
        POP   R0
        STORE R0, R7, 7
        POP   R0
        STORE R0, R7, 6
        POP   R0
        STORE R0, R7, 5
        POP   R0
        STORE R0, R7, 4
        POP   R0
        STORE R0, R7, 3
        POP   R0
        STORE R0, R7, 2
        POP   R0
        STORE R0, R7, 1
        POP   R0
        STORE R0, R7, 0

; ── dispatch ────────────────────────────────────────────────────
; boot jumps straight in here, which is why there is no second copy of it.
dispatch:
        MOVI  R5, 0
        LOAD  R9, R5, 0xF01
        ADDI  R9, R9, 1
        STORE R9, R5, 0xF01     ; ticks++

        LOAD  R6, R5, 0xF00
        ADDI  R6, R6, 1
        CMPI  R6, 3
        JNE   dp_st
        MOVI  R6, 0
dp_st:  STORE R6, R5, 0xF00

        CALL  pcb_of            ; R6 -> R7

        LOAD  R1, R7, 17
        LOAD  R2, R7, 18
        CALL  hal_window_set    ; the window moves with the process
        LOAD  R1, R7, 16
        CALL  hal_epc_set       ; this is the switch itself
        CALL  hal_mode_user

; Armed last: the deadline is counted from when user code resumes, and only
; the sixteen restore loads and the return stand between here and there.
        MOVI  R1, 2047          ; quantum — see hal.hasm for why not 2048
        CALL  hal_timer_arm

; R7 is the pointer, so it is restored last, out of itself.
        LOAD  R0, R7, 0
        LOAD  R1, R7, 1
        LOAD  R2, R7, 2
        LOAD  R3, R7, 3
        LOAD  R4, R7, 4
        LOAD  R5, R7, 5
        LOAD  R6, R7, 6
        LOAD  R8, R7, 8
        LOAD  R9, R7, 9
        LOAD  R10, R7, 10
        LOAD  R11, R7, 11
        LOAD  R12, R7, 12
        LOAD  R13, R7, 13
        LOAD  R14, R7, 14
        LOAD  R15, R7, 15
        LOAD  R7, R7, 7
        ERET

; ── pid in R6 -> block base in R7 ───────────────────────────────
; A subroutine, which this kernel could not have had until CALL and RET were
; built. Two callers, one table.
pcb_of: CMPI  R6, 0
        JEQ   po_a
        CMPI  R6, 1
        JEQ   po_b
        MOVI  R7, 0xF50
        RET
po_a:   MOVI  R7, 0xF10
        RET
po_b:   MOVI  R7, 0xF30
        RET

; ── the three processes ─────────────────────────────────────────
procA:  MOVI  R1, 0
        MOVI  R3, 0x100
pa_lp:  ADDI  R1, R1, 1
        STORE R1, R3, 0
        JMP   pa_lp

procB:  MOVI  R1, 0
        MOVI  R3, 0x200
pb_lp:  ADDI  R1, R1, 100
        STORE R1, R3, 0
        SYSCALL                 ; B gives the rest of its quantum back
        JMP   pb_lp

; ── C: the guard daemon ─────────────────────────────────────────
; Twenty-eight HLOAD/HGRD pairs, unrolled because HLOAD names its ROM index in
; the immediate and cannot take it from a register. One sweep re-validates
; every letter the machine knows.
;
;   R1  sweeps completed      -> 0x300
;   R2  failures seen         -> 0x301
procC:  MOVI  R4, 0x300
        MOVI  R1, 0
        MOVI  R2, 0
pc_lp:
        HLOAD H0, 1
        HGRD  H0
        JGD   ok1
        ADDI  R2, R2, 1
ok1:  NOP
        HLOAD H0, 2
        HGRD  H0
        JGD   ok2
        ADDI  R2, R2, 1
ok2:  NOP
        HLOAD H0, 3
        HGRD  H0
        JGD   ok3
        ADDI  R2, R2, 1
ok3:  NOP
        HLOAD H0, 4
        HGRD  H0
        JGD   ok4
        ADDI  R2, R2, 1
ok4:  NOP
        HLOAD H0, 5
        HGRD  H0
        JGD   ok5
        ADDI  R2, R2, 1
ok5:  NOP
        HLOAD H0, 6
        HGRD  H0
        JGD   ok6
        ADDI  R2, R2, 1
ok6:  NOP
        HLOAD H0, 7
        HGRD  H0
        JGD   ok7
        ADDI  R2, R2, 1
ok7:  NOP
        HLOAD H0, 8
        HGRD  H0
        JGD   ok8
        ADDI  R2, R2, 1
ok8:  NOP
        HLOAD H0, 9
        HGRD  H0
        JGD   ok9
        ADDI  R2, R2, 1
ok9:  NOP
        HLOAD H0, 10
        HGRD  H0
        JGD   ok10
        ADDI  R2, R2, 1
ok10:  NOP
        HLOAD H0, 11
        HGRD  H0
        JGD   ok11
        ADDI  R2, R2, 1
ok11:  NOP
        HLOAD H0, 12
        HGRD  H0
        JGD   ok12
        ADDI  R2, R2, 1
ok12:  NOP
        HLOAD H0, 13
        HGRD  H0
        JGD   ok13
        ADDI  R2, R2, 1
ok13:  NOP
        HLOAD H0, 14
        HGRD  H0
        JGD   ok14
        ADDI  R2, R2, 1
ok14:  NOP
        HLOAD H0, 15
        HGRD  H0
        JGD   ok15
        ADDI  R2, R2, 1
ok15:  NOP
        HLOAD H0, 16
        HGRD  H0
        JGD   ok16
        ADDI  R2, R2, 1
ok16:  NOP
        HLOAD H0, 17
        HGRD  H0
        JGD   ok17
        ADDI  R2, R2, 1
ok17:  NOP
        HLOAD H0, 18
        HGRD  H0
        JGD   ok18
        ADDI  R2, R2, 1
ok18:  NOP
        HLOAD H0, 19
        HGRD  H0
        JGD   ok19
        ADDI  R2, R2, 1
ok19:  NOP
        HLOAD H0, 20
        HGRD  H0
        JGD   ok20
        ADDI  R2, R2, 1
ok20:  NOP
        HLOAD H0, 21
        HGRD  H0
        JGD   ok21
        ADDI  R2, R2, 1
ok21:  NOP
        HLOAD H0, 22
        HGRD  H0
        JGD   ok22
        ADDI  R2, R2, 1
ok22:  NOP
        HLOAD H0, 23
        HGRD  H0
        JGD   ok23
        ADDI  R2, R2, 1
ok23:  NOP
        HLOAD H0, 24
        HGRD  H0
        JGD   ok24
        ADDI  R2, R2, 1
ok24:  NOP
        HLOAD H0, 25
        HGRD  H0
        JGD   ok25
        ADDI  R2, R2, 1
ok25:  NOP
        HLOAD H0, 26
        HGRD  H0
        JGD   ok26
        ADDI  R2, R2, 1
ok26:  NOP
        HLOAD H0, 27
        HGRD  H0
        JGD   ok27
        ADDI  R2, R2, 1
ok27:  NOP
        HLOAD H0, 28
        HGRD  H0
        JGD   ok28
        ADDI  R2, R2, 1
ok28:  NOP
        ADDI  R1, R1, 1
        STORE R1, R4, 0
        STORE R2, R4, 1
        JMP   pc_lp

; ── the layer underneath ────────────────────────────────────────
; At the end, so nothing falls into it: procC's loop never exits. Every
; peripheral address this kernel touches lives in there, which is what makes
; the kernel portable and this file free of a single peripheral literal.
        .include "hal.hasm"
