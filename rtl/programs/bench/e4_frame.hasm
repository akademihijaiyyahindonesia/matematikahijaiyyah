; ============================================================================
; E4 — pancarkan frame HISAB 9 byte untuk Ba
; ============================================================================
; Ketiga kata plus digest. Mustahil sebelum HPACK menghormati pemilih
; kata: hanya kata 0 yang pernah terpilih, jadi 4 dari 9 byte.
; Diharapkan: 65824 285212673 16144 2586908108
; (0x00010120, 0x11000001, 0x00003F10, 0x9A3115CC)
;
; Dibangkitkan oleh tools/make_bench.py — jangan disunting tangan.
; Jalankan: cd rtl/fpga/gowin && make bitstream PROGRAM=../../programs/bench/e4_frame.hasm
; Bacaan   : CYCLES=xxxxxxxx pada UART setelah halt.
        HLOAD   H0, #2
        HPACK   R1, H0, 0
        PRINT   R1
        HPACK   R2, H0, 1
        PRINT   R2
        HPACK   R3, H0, 2
        PRINT   R3
        HCRC    R4, H0
        PRINT   R4
        HALT
