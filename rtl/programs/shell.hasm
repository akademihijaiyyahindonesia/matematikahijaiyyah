; shell.hasm — H-Kernel boots, schedules two processes, and the second of them
; is a shell that takes commands off the serial line.
;
; kernel.hasm proved the scheduler with three processes that only counted.
; This is the same machinery with the piece M3 asks for added: a process that
; READS, and a kernel that serves it. The route is the one the owner drew, and
; it is the only route there is -- every peripheral address lives in hal.hasm,
; inside the window user mode is refused:
;
;     shell -> SYSCALL -> kernel -> HAL -> UART
;
; ── what a command looks like ───────────────────────────────────
; ONE BYTE IS ONE COMMAND, and it is echoed as the CHARACTER it is:
;
;   'p' (0x70)   ps -- the process count, then each pid, as numbers
;   anything     echo -- the character itself, then the prompt again
;
; So typing A answers A, and typing p answers 2, 0, 1. A number is still
; printed as a number: PRINT for integers, EMITS for characters, and the two
; do not borrow from each other.
;
; This program used to answer 65 for A, and said so in a paragraph explaining
; that no character could reach the wire. H-ISA v1.1 gave EMITS (0xA2) its
; string shape -- one ASCII byte per 32-bit word, a zero word ends it, §13.1.1
; -- so the paragraph is gone and the banner is here.
;
; PRINTH (0xA1) stays software-only and stays out of this: it prints a codex.
; PRINT integers, PRINTH codices, EMITS characters.
;
; ── the syscall table ───────────────────────────────────────────
;   1 write    R2 -> the wire as a NUMBER, through the kernel's PRINT
;   2 read     -> R1, one byte, or 0 when none is waiting
;   3 yield    give up the rest of the quantum
;   4 exit     stop being scheduled
;   5 puts     the string in the caller's BUFFER -> the wire, via EMITS
;
; Five is this kernel's own numbering, not the spec's: §13.3's table is marked
; [PLANNED] and this one already diverged from it at call 1.
;
; `puts` takes no argument, and that is EMITS's shape rather than a choice:
; §6.2 gives it format I, so its address is an IMMEDIATE and there is no
; computed jump or computed immediate in this ISA to make it a register. So
; the kernel prints ONE fixed address, 0x210, and the caller writes whatever
; it wants printed there. The buffer is inside the shell's own window, which is
; the only memory the shell may write anyway.
;
; The table lives in data memory at 0xF08+n, one word per call, 1 meaning
; implemented. It is a TABLE AND NOT A JUMP TABLE, because this ISA has no
; computed jump: every target in §6.2 is an immediate, CALL included. So the
; arms are still comparisons, and what the table decides is whether an arm may
; run at all. Zeroing one word turns off exactly one call, which is what makes
; it testable by breaking it.
;
; ── two things user code here must not do ───────────────────────
; NO CALL IN A USER PROCESS. The return-address stack is not part of a
; context -- a process that used CALL would return through another's address.
; Recorded in cosmictera-build/OFF.md since the kernel was built.
;
; FLAGS IS PART OF THE CONTEXT NOW. It was not until H-ISA v1.1: nothing could
; read it into a register, so a process preempted between a CMP and the branch
; that reads it lost its comparison to the handler's own. `FRD` and `FWR`
; (0x0A/0x0B) close that, and this kernel saves FLAGS at PCB+20 alongside the
; sixteen registers and the PC.
;
; The discipline of putting every CMP immediately before the branch that reads
; it is kept anyway. It costs nothing, and it is what a reader of this file
; should copy: the repair makes the timer safe, not the habit unnecessary.
;
; ── memory map ──────────────────────────────────────────────────
;   0x100-0x1FF  pid 0's window       0x200-0x2FF  pid 1's window (shell)
;   0xF00 current pid                 0xF01 ticks
;   0xF08+n      syscall table, n = 1..4
;   0xF10 PCB[0]                      0xF30 PCB[1]
;
; PCB, in words from its base:
;   +0..+15  R0..R15   +16 pc   +17 mem_base   +18 mem_limit   +19 runnable
;   +20 flags
;
; The kernel publishes the process count into the shell's OWN window at 0x200
; before it starts it. That is how `ps` reads real data without a syscall of
; its own: user code may read its window, and the kernel may write into it.

boot:
        MOVI  R5, 0
        MOVI  R1, vector
        CALL  hal_vector_set

; ── pid 0's block ─────────────────────────────────────────────
        MOVI  R7, 0xF10
        MOVI  R1, 0
        STORE R1, R7, 0
        STORE R1, R7, 1
        STORE R1, R7, 2
        STORE R1, R7, 3
        STORE R1, R7, 4
        STORE R1, R7, 5
        STORE R1, R7, 6
        STORE R1, R7, 7
        STORE R1, R7, 8
        STORE R1, R7, 9
        STORE R1, R7, 10
        STORE R1, R7, 11
        STORE R1, R7, 12
        STORE R1, R7, 13
        STORE R1, R7, 14
        STORE R1, R7, 15
        MOVI  R1, proc0
        STORE R1, R7, 16
        MOVI  R1, 0x100
        STORE R1, R7, 17
        MOVI  R1, 0x200
        STORE R1, R7, 18
        MOVI  R1, 1
        STORE R1, R7, 19        ; runnable
        MOVI  R1, 0
        STORE R1, R7, 20        ; flags

; ── pid 1's block: the shell ──────────────────────────────────
        MOVI  R7, 0xF30
        MOVI  R1, 0
        STORE R1, R7, 0
        STORE R1, R7, 1
        STORE R1, R7, 2
        STORE R1, R7, 3
        STORE R1, R7, 4
        STORE R1, R7, 5
        STORE R1, R7, 6
        STORE R1, R7, 7
        STORE R1, R7, 8
        STORE R1, R7, 9
        STORE R1, R7, 10
        STORE R1, R7, 11
        STORE R1, R7, 12
        STORE R1, R7, 13
        STORE R1, R7, 14
        STORE R1, R7, 15
        MOVI  R1, shell
        STORE R1, R7, 16
        MOVI  R1, 0x200
        STORE R1, R7, 17
        MOVI  R1, 0x300
        STORE R1, R7, 18
        MOVI  R1, 1
        STORE R1, R7, 19
        MOVI  R1, 0
        STORE R1, R7, 20        ; flags

; ── the syscall table ─────────────────────────────────────────
        MOVI  R1, 1
        STORE R1, R5, 0xF09     ; 1 write
        STORE R1, R5, 0xF0A     ; 2 read
        STORE R1, R5, 0xF0B     ; 3 yield
        STORE R1, R5, 0xF0C     ; 4 exit
        STORE R1, R5, 0xF0D     ; 5 puts

; ── what the shell is allowed to know ─────────────────────────
        MOVI  R1, 2
        STORE R1, R5, 0x200     ; process count, inside the shell's window

        MOVI  R1, 0
        STORE R1, R5, 0xF01     ; ticks = 0
        MOVI  R1, 1
        STORE R1, R5, 0xF00     ; pid = 1, so the first dispatch wraps to 0

; THE STALE EXPIRY IS ACKNOWLEDGED BEFORE THE TIMER IS ALLOWED TO INTERRUPT.
; `expired` is counter == compare, and at reset both are 0 -- so it is already
; true before any deadline has been set. Enabling the timer on top of that
; takes a trap the kernel never asked for, at a moment when the front end has
; no user PC to name: measured, epc came out 0, the first save wrote 0 into pid
; 0's block, and pid 0 then ran the boot code in user mode until the HAL's
; first peripheral store faulted it (cause 3) forever.
;
; Acknowledged and not armed. Arming here would clear the bit too, but it would
; also plant a deadline that lands during the first dispatch -- measured, that
; simply moved the same failure a few hundred cycles later. The deadline that
; matters is the one dispatch sets, last, just before user code resumes.
        CALL  hal_timer_ack
        MOVI  R1, 1             ; timer only. A syscall is an exception and
        CALL  hal_trap_enable   ; cannot be masked.
        JMP   dispatch

; ── trap entry ──────────────────────────────────────────────────
; Sixteen pushes before anything else. Nothing above this line may use a
; register, because every register still belongs to the process.
vector:
        PUSH  R0
        PUSH  R1
        PUSH  R2
        PUSH  R3
        PUSH  R4
        PUSH  R5
        PUSH  R6
        PUSH  R7
        PUSH  R8
        PUSH  R9
        PUSH  R10
        PUSH  R11
        PUSH  R12
        PUSH  R13
        PUSH  R14
        PUSH  R15

; FLAGS IS CAPTURED HERE, BEFORE THE KERNEL COMPARES ANYTHING. The sixteen
; pushes are what make it possible: every register is on the stack, so R0 is
; free even though its value still belongs to the process.
;
; It cannot wait until after the save loop. `pcb_of` compares a pid and the
; cause test compares a 5, and either overwrites what this instruction is
; here to keep -- measured, with FRD placed after them: a process that set
; 0x05 read back 0x0d, and one that set 0x0a read back 0x08, both carrying
; the kernel's own comparison. rtl/tb/tb_hcpu_flags_ctx.v is what caught it.
        FRD   R0

; From here every register is scratch: the values are all on the stack.
;
; THE TIMER IS MASKED FIRST, and this kernel needs that where kernel.hasm did
; not. Serving `write` means PRINT, and PRINT BLOCKS until the byte is on the
; wire: 10 bits at 115200 baud is about 2,344 clocks at 27 MHz, and a
; three-digit answer with its newline is four of them -- roughly 9,400, against
; a quantum of 2,047. So the deadline armed before user code resumed expires
; while the handler is still inside PRINT, and a trap is not masked by
; supervisor mode. Measured before it was masked: pid 0 froze at count 337
; with cause 3 and its saved pc at 260, which is an address inside hal.hasm --
; the kernel had written its OWN pc into a process block, exactly the failure
; kernel.hasm's header describes from the other direction.
;
; Re-enabled in dispatch, after the next deadline is set, so the window is two
; instructions wide and the deadline is already 2,047 away.
        MOVI  R5, 0
        LOAD  R6, R5, 0xF00
        CALL  pcb_of            ; R6 -> R7
        STORE R0, R7, 20        ; the flags grabbed on entry, now that R7 exists

        CALL  hal_epc_get
        MOV   R8, R1
        CALL  hal_cause_get
        MOV   R13, R1           ; the cause outlives the save loop
        CMPI  R1, 5
        JNE   sv_st
        ADDI  R8, R8, 1         ; a syscall names its own instruction: serve it
sv_st:  STORE R8, R7, 16

; The stack gives them back newest first, so R15 comes off first. Only R0 is
; used as the landing register, so R7 and R13 survive all sixteen stores.
        POP   R0
        STORE R0, R7, 15
        POP   R0
        STORE R0, R7, 14
        POP   R0
        STORE R0, R7, 13
        POP   R0
        STORE R0, R7, 12
        POP   R0
        STORE R0, R7, 11
        POP   R0
        STORE R0, R7, 10
        POP   R0
        STORE R0, R7, 9
        POP   R0
        STORE R0, R7, 8
        POP   R0
        STORE R0, R7, 7
        POP   R0
        STORE R0, R7, 6
        POP   R0
        STORE R0, R7, 5
        POP   R0
        STORE R0, R7, 4
        POP   R0
        STORE R0, R7, 3
        POP   R0
        STORE R0, R7, 2
        POP   R0
        STORE R0, R7, 1
        POP   R0
        STORE R0, R7, 0

; Serving happens AFTER the save, never before: the arguments are read out of
; the block and the result is written back into it, so a call that is answered
; and a process that is preempted leave the machine in the same shape.
        CMPI  R13, 5
        JNE   dispatch
        CALL  serve

; ── dispatch ────────────────────────────────────────────────────
; boot jumps straight in here, which is why there is no second copy of it.
dispatch:
        MOVI  R5, 0
        LOAD  R9, R5, 0xF01
        ADDI  R9, R9, 1
        STORE R9, R5, 0xF01     ; ticks++

        LOAD  R6, R5, 0xF00
        MOVI  R10, 0            ; how many blocks have been looked at
dp_nx:  ADDI  R6, R6, 1
        CMPI  R6, 2
        JNE   dp_ck
        MOVI  R6, 0
dp_ck:  CALL  pcb_of            ; R6 -> R7
        LOAD  R3, R7, 19
        CMPI  R3, 0
        JNE   dp_st             ; runnable: take it
        ADDI  R10, R10, 1
        CMPI  R10, 2
        JNE   dp_nx
        HALT                    ; every process has exited
dp_st:  STORE R6, R5, 0xF00

        LOAD  R1, R7, 17
        LOAD  R2, R7, 18
        CALL  hal_window_set    ; the window moves with the process
        LOAD  R1, R7, 16
        CALL  hal_epc_set       ; this is the switch itself
        CALL  hal_mode_user

; Armed last: the deadline is counted from when user code resumes, and only
; the sixteen restore loads and the return stand between here and there.
        MOVI  R1, 2047          ; quantum — see hal.hasm for why not 2048
        CALL  hal_timer_arm
        MOVI  R1, 1             ; and only now may the timer interrupt again
        CALL  hal_trap_enable

; R7 is the pointer, so it is restored last, out of itself.
        LOAD  R0, R7, 0
        LOAD  R1, R7, 1
        LOAD  R2, R7, 2
        LOAD  R3, R7, 3
        LOAD  R4, R7, 4
        LOAD  R5, R7, 5
        LOAD  R6, R7, 6
        LOAD  R8, R7, 8
        LOAD  R9, R7, 9
        LOAD  R10, R7, 10
        LOAD  R11, R7, 11
        LOAD  R12, R7, 12
        LOAD  R13, R7, 13
        LOAD  R14, R7, 14
        LOAD  R15, R7, 15
; FLAGS is restored BEFORE the last two loads, not after: `FWR` reads a GPR, so
; it must run while a scratch register is still free. R0 is reloaded again
; below, so borrowing it here costs nothing.
        LOAD  R0, R7, 20
        FWR   R0
        LOAD  R0, R7, 0
        LOAD  R7, R7, 7
        ERET

; ── serve one call ──────────────────────────────────────────────
; R7 is the caller's block. The call number and its argument are the caller's
; saved R1 and R2; the result goes back into saved R1, which is how the user
; sees it after the restore.
serve:  LOAD  R1, R7, 1
        LOAD  R2, R7, 2
        CMPI  R1, 1
        JEQ   sc_wr
        CMPI  R1, 2
        JEQ   sc_rd
        CMPI  R1, 3
        JEQ   sc_yl
        CMPI  R1, 4
        JEQ   sc_ex
        CMPI  R1, 5
        JEQ   sc_pu
        MOVI  R1, 0             ; no such call
        JMP   sc_ret

; Each arm reads ITS OWN table word first, so zeroing one word disables one
; call and nothing else.
sc_wr:  MOVI  R5, 0
        LOAD  R3, R5, 0xF09
        CMPI  R3, 0
        JEQ   sc_off
        PRINT R2                ; privileged: this is why write is a call
        MOVI  R1, 1
        JMP   sc_ret

; Non-blocking. A kernel that spun here would stop scheduling, so an empty
; line returns 0 and the caller yields. 0 is safe as "nothing": a terminal
; sending NUL is not a command this shell has, and a NUL would simply be
; echoed as 0 if one ever arrived.
sc_rd:  MOVI  R5, 0
        LOAD  R3, R5, 0xF0A
        CMPI  R3, 0
        JEQ   sc_off
        CALL  hal_uart_rx_ready
        CMPI  R1, 0
        JEQ   sc_none
        CALL  hal_uart_rx_get   ; R1 = the byte
        JMP   sc_ret
sc_none: MOVI R1, 0
        JMP   sc_ret

; Yield needs no body. Returning from here falls into dispatch, which moves to
; the next process -- giving up the rest of the quantum IS the whole call.
sc_yl:  MOVI  R5, 0
        LOAD  R3, R5, 0xF0B
        CMPI  R3, 0
        JEQ   sc_off
        MOVI  R1, 1
        JMP   sc_ret

sc_ex:  MOVI  R5, 0
        LOAD  R3, R5, 0xF0C
        CMPI  R3, 0
        JEQ   sc_off
        MOVI  R1, 0
        STORE R1, R7, 19        ; no longer runnable
        MOVI  R1, 1
        JMP   sc_ret

; EMITS is privileged for the same reason PRINT is, so a string reaches the
; wire the same way a number does: by asking.
sc_pu:  MOVI  R5, 0
        LOAD  R3, R5, 0xF0D
        CMPI  R3, 0
        JEQ   sc_off
        EMITS 0x210             ; the one address; the caller fills it
        MOVI  R1, 1
        JMP   sc_ret

sc_off: MOVI  R1, 0             ; the table says this call is not here
sc_ret: STORE R1, R7, 1
        RET

; ── pid in R6 -> block base in R7 ───────────────────────────────
pcb_of: CMPI  R6, 0
        JEQ   po_0
        MOVI  R7, 0xF30
        RET
po_0:   MOVI  R7, 0xF10
        RET

; ── pid 0 ───────────────────────────────────────────────────────
; It counts, it stores, and it never yields. Only the timer takes it away, so
; a counter that keeps climbing while the shell sits at its prompt is the
; proof that preemption is real rather than cooperative.
proc0:  MOVI  R1, 0
        MOVI  R3, 0x100
p0_lp:  ADDI  R1, R1, 1
        STORE R1, R3, 0
        JMP   p0_lp

; ── pid 1: the shell ────────────────────────────────────────────
; Every CMP below is followed immediately by the branch that reads it, and no
; SYSCALL stands between the two. See the note at the top: FLAGS does not
; survive a trap, and this is the only defence software has.
; Everything printed as text goes through the one buffer at 0x210, written a
; character at a time. That is verbose and it is the point: the shape of the
; string in memory is one ASCII byte per word with a zero word after it, and
; writing it out longhand is the same shape the spec fixes in §13.1.1.
;
; The banner runs once. HIJAIYYAH is nine characters and the tenth word ends
; it -- exactly the acceptance string rtl/tb/tb_hcpu_emits.v prints.
shell:  MOVI  R5, 0
        MOVI  R1, 0x48
        STORE R1, R5, 0x210     ; H
        MOVI  R1, 0x49
        STORE R1, R5, 0x211     ; I
        MOVI  R1, 0x4A
        STORE R1, R5, 0x212     ; J
        MOVI  R1, 0x41
        STORE R1, R5, 0x213     ; A
        MOVI  R1, 0x49
        STORE R1, R5, 0x214     ; I
        MOVI  R1, 0x59
        STORE R1, R5, 0x215     ; Y
        MOVI  R1, 0x59
        STORE R1, R5, 0x216     ; Y
        MOVI  R1, 0x41
        STORE R1, R5, 0x217     ; A
        MOVI  R1, 0x48
        STORE R1, R5, 0x218     ; H
        MOVI  R1, 0x0A
        STORE R1, R5, 0x219     ; newline -- the banner ends its own line
        MOVI  R1, 0
        STORE R1, R5, 0x21A
        MOVI  R1, 5
        SYSCALL

; The prompt: '>' and a space, and NO newline, so the cursor waits where the
; typing will go. PRINT could never do this -- it ends every number with a
; newline, which is why a prompt was impossible before EMITS.
sh_pr:  MOVI  R5, 0
        MOVI  R1, 0x3E
        STORE R1, R5, 0x210     ; >
        MOVI  R1, 0x20
        STORE R1, R5, 0x211     ; space
        MOVI  R1, 0
        STORE R1, R5, 0x212
        MOVI  R1, 5
        SYSCALL

sh_lp:  MOVI  R1, 2             ; read
        SYSCALL
        CMPI  R1, 0
        JEQ   sh_idle           ; nothing waiting
        CMPI  R1, 0x70          ; 'p' -- ps
        JEQ   sh_ps

; echo: the CHARACTER, not its code. The byte goes in the first word, a
; newline in the second so the answer ends its line, and the terminator third.
        MOVI  R5, 0
        STORE R1, R5, 0x210
        MOVI  R1, 0x0A
        STORE R1, R5, 0x211
        MOVI  R1, 0
        STORE R1, R5, 0x212
        MOVI  R1, 5
        SYSCALL
        JMP   sh_pr

sh_idle: MOVI R1, 3             ; yield
        SYSCALL
        JMP   sh_lp

; ps: the count the kernel published into this window, then every pid below
; it. The count is READ, not assumed -- changing the published word changes
; what ps says.
sh_ps:  MOVI  R5, 0
        LOAD  R4, R5, 0x200
        MOV   R2, R4
        MOVI  R1, 1
        SYSCALL
        MOVI  R3, 0
sh_pl:  MOV   R2, R3
        MOVI  R1, 1
        SYSCALL
        ADDI  R3, R3, 1
        CMP   R3, R4
        JNE   sh_pl
        JMP   sh_pr

; ── the layer underneath ────────────────────────────────────────
; At the end, so nothing falls into it: the shell's loop never exits. Every
; peripheral address this kernel touches lives in there.
        .include "hal.hasm"
