; flags_ctx.hasm — does FLAGS belong to the process, or to whoever ran last?
;
; Two processes, each with its own flag pattern, preempted by the timer for as
; long as the bench watches. Each publishes what it reads back into its own
; window, so the answer is a number in memory rather than a claim:
;
;   0x100  what pid 0 last read from FRD      0x101  pid 0's loop counter
;   0x200  what pid 1 last read from FRD      0x201  pid 1's loop counter
;
; Both counters must climb -- otherwise nothing was preempted and the test is
; vacuous -- and both published values must be the process's OWN pattern.
;
; ── why the patterns are what they are ──────────────────────────
; 0x05 is G and O; 0x0A is Z and LT. They share no bit, so a process reading
; the other's pattern, or the kernel's, cannot be mistaken for a near miss.
; Both also carry a bit no instruction in this machine writes: bit 2 in one,
; and nothing above bit 3 in either -- FWR writes all eight and FRD hands all
; eight back, which is what makes a saved context whole.
;
; ── what the loop may and may not do ────────────────────────────
; Only CMP and CMPI write the arithmetic flags, so ADDI, STORE, FRD and JMP
; leave them alone. The loop is built out of exactly those: it must burn time
; without touching the thing it is measuring. There is no CMP in either
; process, on purpose.
;
; ── what this looked like before H-ISA v1.1 ─────────────────────
; It could not be written. FLAGS was reachable only by the J-forms -- no
; instruction read it into a register -- so a kernel could not save it and this
; program could not observe it. Measured then, indirectly: a loop carrying one
; comparison, swept against sixty timer deadlines, had five of them reverse the
; branch, because the handler's own CMP of TRAP_CAUSE overwrote the process's.
;
; ── memory map ──────────────────────────────────────────────────
;   0x100-0x1FF  pid 0's window    0x200-0x2FF  pid 1's window
;   0xF00 current pid              0xF01 ticks
;   0xF10 PCB[0]                   0xF30 PCB[1]
;
; PCB: +0..+15 R0..R15   +16 pc   +17 mem_base   +18 mem_limit   +20 flags

boot:
        MOVI  R5, 0
        MOVI  R1, vector
        CALL  hal_vector_set

; ── pid 0's block ─────────────────────────────────────────────
        MOVI  R7, 0xF10
        MOVI  R1, 0
        STORE R1, R7, 0
        STORE R1, R7, 1
        STORE R1, R7, 2
        STORE R1, R7, 3
        STORE R1, R7, 4
        STORE R1, R7, 5
        STORE R1, R7, 6
        STORE R1, R7, 7
        STORE R1, R7, 8
        STORE R1, R7, 9
        STORE R1, R7, 10
        STORE R1, R7, 11
        STORE R1, R7, 12
        STORE R1, R7, 13
        STORE R1, R7, 14
        STORE R1, R7, 15
        STORE R1, R7, 20        ; flags start clear
        MOVI  R1, proc0
        STORE R1, R7, 16
        MOVI  R1, 0x100
        STORE R1, R7, 17
        MOVI  R1, 0x200
        STORE R1, R7, 18

; ── pid 1's block ─────────────────────────────────────────────
        MOVI  R7, 0xF30
        MOVI  R1, 0
        STORE R1, R7, 0
        STORE R1, R7, 1
        STORE R1, R7, 2
        STORE R1, R7, 3
        STORE R1, R7, 4
        STORE R1, R7, 5
        STORE R1, R7, 6
        STORE R1, R7, 7
        STORE R1, R7, 8
        STORE R1, R7, 9
        STORE R1, R7, 10
        STORE R1, R7, 11
        STORE R1, R7, 12
        STORE R1, R7, 13
        STORE R1, R7, 14
        STORE R1, R7, 15
        STORE R1, R7, 20
        MOVI  R1, proc1
        STORE R1, R7, 16
        MOVI  R1, 0x200
        STORE R1, R7, 17
        MOVI  R1, 0x300
        STORE R1, R7, 18

        MOVI  R1, 0
        STORE R1, R5, 0xF01     ; ticks = 0
        MOVI  R1, 1
        STORE R1, R5, 0xF00     ; pid = 1, so the first dispatch wraps to 0

        CALL  hal_timer_ack     ; the expiry that is true at reset
        MOVI  R1, 1
        CALL  hal_trap_enable
        JMP   dispatch

; ── trap entry ──────────────────────────────────────────────────
vector:
        PUSH  R0
        PUSH  R1
        PUSH  R2
        PUSH  R3
        PUSH  R4
        PUSH  R5
        PUSH  R6
        PUSH  R7
        PUSH  R8
        PUSH  R9
        PUSH  R10
        PUSH  R11
        PUSH  R12
        PUSH  R13
        PUSH  R14
        PUSH  R15

; FLAGS IS CAPTURED HERE, BEFORE THE KERNEL COMPARES ANYTHING. The sixteen
; pushes are what make it possible: every register is on the stack, so R0 is
; free even though its value still belongs to the process.
;
; It cannot wait until after the save loop. `pcb_of` compares a pid and the
; cause test compares a 5, and either overwrites what this instruction is
; here to keep -- measured, with FRD placed after them: a process that set
; 0x05 read back 0x0d, and one that set 0x0a read back 0x08, both carrying
; the kernel's own comparison. rtl/tb/tb_hcpu_flags_ctx.v is what caught it.
        FRD   R0

        MOVI  R5, 0
        MOVI  R1, 0
        CALL  hal_trap_enable   ; the timer stays out of its own handler
        LOAD  R6, R5, 0xF00
        CALL  pcb_of            ; R6 -> R7
        STORE R0, R7, 20        ; the flags grabbed on entry, now that R7 exists

        CALL  hal_epc_get
        MOV   R8, R1
        CALL  hal_cause_get
        CMPI  R1, 5
        JNE   sv_st
        ADDI  R8, R8, 1
sv_st:  STORE R8, R7, 16

        POP   R0
        STORE R0, R7, 15
        POP   R0
        STORE R0, R7, 14
        POP   R0
        STORE R0, R7, 13
        POP   R0
        STORE R0, R7, 12
        POP   R0
        STORE R0, R7, 11
        POP   R0
        STORE R0, R7, 10
        POP   R0
        STORE R0, R7, 9
        POP   R0
        STORE R0, R7, 8
        POP   R0
        STORE R0, R7, 7
        POP   R0
        STORE R0, R7, 6
        POP   R0
        STORE R0, R7, 5
        POP   R0
        STORE R0, R7, 4
        POP   R0
        STORE R0, R7, 3
        POP   R0
        STORE R0, R7, 2
        POP   R0
        STORE R0, R7, 1
        POP   R0
        STORE R0, R7, 0

; ── dispatch ────────────────────────────────────────────────────
dispatch:
        MOVI  R5, 0
        LOAD  R9, R5, 0xF01
        ADDI  R9, R9, 1
        STORE R9, R5, 0xF01

        LOAD  R6, R5, 0xF00
        ADDI  R6, R6, 1
        CMPI  R6, 2
        JNE   dp_st
        MOVI  R6, 0
dp_st:  STORE R6, R5, 0xF00

        CALL  pcb_of
        LOAD  R1, R7, 17
        LOAD  R2, R7, 18
        CALL  hal_window_set
        LOAD  R1, R7, 16
        CALL  hal_epc_set
        CALL  hal_mode_user

        MOVI  R1, 2047
        CALL  hal_timer_arm
        MOVI  R1, 1
        CALL  hal_trap_enable

        LOAD  R1, R7, 1
        LOAD  R2, R7, 2
        LOAD  R3, R7, 3
        LOAD  R4, R7, 4
        LOAD  R5, R7, 5
        LOAD  R6, R7, 6
        LOAD  R8, R7, 8
        LOAD  R9, R7, 9
        LOAD  R10, R7, 10
        LOAD  R11, R7, 11
        LOAD  R12, R7, 12
        LOAD  R13, R7, 13
        LOAD  R14, R7, 14
        LOAD  R15, R7, 15
; FLAGS goes back before the last two loads, while a scratch register is still
; free: FWR reads a GPR, and R0 is reloaded immediately after.
        LOAD  R0, R7, 20
        FWR   R0
        LOAD  R0, R7, 0
        LOAD  R7, R7, 7
        ERET

; ── pid in R6 -> block base in R7 ───────────────────────────────
pcb_of: CMPI  R6, 0
        JEQ   po_0
        MOVI  R7, 0xF30
        RET
po_0:   MOVI  R7, 0xF10
        RET

; ── pid 0: G and O ──────────────────────────────────────────────
; The FWR happens once. Everything after it must leave FLAGS alone, so the
; loop is ADDI, FRD, STORE, JMP and nothing else.
proc0:  MOVI  R1, 0x05
        FWR   R1
        MOVI  R3, 0x100
        MOVI  R4, 0
p0_lp:  ADDI  R4, R4, 1
        FRD   R2
        STORE R2, R3, 0         ; what I read back
        STORE R4, R3, 1         ; and that I am still running
        JMP   p0_lp

; ── pid 1: Z and LT ─────────────────────────────────────────────
proc1:  MOVI  R1, 0x0A
        FWR   R1
        MOVI  R3, 0x200
        MOVI  R4, 0
p1_lp:  ADDI  R4, R4, 1
        FRD   R2
        STORE R2, R3, 0
        STORE R4, R3, 1
        JMP   p1_lp

; ── the layer underneath ────────────────────────────────────────
        .include "hal.hasm"
