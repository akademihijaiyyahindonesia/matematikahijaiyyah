; trap_flags.hasm — a handler that does not save FLAGS destroys them.
;
; Prints ONE value: 1 if a comparison survived a trap, 0 if it did not. This
; handler does not save FLAGS, so it prints 0 -- and that is now a statement
; about THIS HANDLER rather than about the machine.
;
; ── what it asks ────────────────────────────────────────────────
; User code compares, takes a trap before the branch that reads the result,
; and then asks the branch which way it went. The handler cannot avoid
; comparing -- it has to read TRAP_CAUSE and decide -- so the handler's Z is
; the one the user's JEQ sees.
;
; ── what changed under it, and what did not ─────────────────────
; When this program was written the answer was a property of the MACHINE:
; sixteen GPRs, the PC and the memory window were saved by a context switch,
; FLAGS was none of them, and nothing could reach it -- §6.2 had CMP/CMPI to
; write FLAGS and the J-forms to read it, and nothing else. A field software
; could not touch.
;
; H-ISA v1.1 added `FRD` (0x0A) and `FWR` (0x0B), and
; rtl/programs/flags_ctx.hasm now shows two processes keeping their own flag
; patterns across preemption -- on the board, 5 and 10 with both still running.
;
; So this program measures what it always measured, and the reading has not
; changed: a handler that does not save FLAGS still destroys them, because the
; handler must compare TRAP_CAUSE and that comparison is the process's. What
; changed is whose fault it is. This one is written WITHOUT the save on
; purpose, so the cost of leaving it out stays visible and measured.
;
; ── found while writing this ────────────────────────────────────
; A `STORE R, TRAP_EPC` IMMEDIATELY followed by `ERET` returns to the OLD epc.
; Measured on the board: the same SYSCALL at PC 80 trapped three times in a
; row, printing 80 each time, until three NOPs were put between the store and
; the ERET. rtl/hcpu_trap.v already carries the bypass for the same hazard on
; TRAP_MODE, and its comment says of that one "the fix is not to require one
; [NOP]" -- TRAP_EPC did not get the same treatment. Also in OFF.md.

        MOVI  R5, 0
        MOVI  R14, 0
        MOVI  R1, handler
        STORE R1, R5, 0xFF8     ; TRAP_VECTOR
        MOVI  R1, 0x100
        STORE R1, R5, 0xFFE     ; MEM_BASE
        MOVI  R1, 0x200
        STORE R1, R5, 0xFFF     ; MEM_LIMIT
        MOVI  R1, usr
        STORE R1, R5, 0xFF9     ; TRAP_EPC
        MOVI  R1, 0
        STORE R1, R5, 0xFFD     ; previous mode = USER
        ERET

; ── user mode ───────────────────────────────────────────────────
; R1 and R2 are loaded BEFORE the comparison, so nothing between CMPI and the
; branch touches FLAGS except the trap itself.
usr:    MOVI  R4, 0
        MOVI  R1, 1             ; call 1 = write
        MOVI  R2, 9             ; a value the handler will not print
        CMPI  R4, 0             ; Z = 1
        SYSCALL                 ; the handler compares; whose Z survives?
        JEQ   kept              ; taken only if the user's Z is still there
        MOVI  R2, 0             ; fell through: the comparison was lost
        JMP   say
kept:   MOVI  R2, 1
say:    MOVI  R1, 1
        SYSCALL                 ; the kernel prints the verdict
spin:   JMP   spin

; ── handler ─────────────────────────────────────────────────────
; The first call is silent so only the verdict reaches the wire; the second
; prints it and stops the machine.
handler:
        LOAD  R9, R5, 0xFFA     ; TRAP_CAUSE
        CMPI  R9, 5             ; TRAP_SYSCALL -- and this is the comparison
        JEQ   h_call            ; that overwrites the user's
        HALT
h_call: ADDI  R14, R14, 1
        CMPI  R14, 2
        JEQ   h_say
        LOAD  R11, R5, 0xFF9
        ADDI  R11, R11, 1
        STORE R11, R5, 0xFF9
        NOP                     ; the store must land before ERET reads epc
        NOP
        NOP
        ERET
h_say:  PRINT R2
        HALT
