; trap_timer.hasm — a timer interrupt, taken and returned from.
;
; This is the smallest program that proves traps work rather than merely
; compile: a loop that would never stop on its own is preempted, a handler
; runs, and the loop resumes and then finishes. If the trap never fired the
; program would spin forever; if ERET were wrong it would never come back.
;
; The trap unit is reached as memory. Nothing here needed a new instruction
; except ERET, and ERET exists only because clearing the in-trap latch and
; redirecting the fetch have to be one indivisible act.
;
;   R5   zero base for every peripheral access
;   R7   the loop counter the trap interrupts
;   R8   set by the handler; the loop waits on it
;   R9   the cause the handler read back
;   R10  the epc the handler read back

; A DEADLINE HAS TO BE RELATIVE. This program set COMPARE to a bare 12 and it
; worked in every simulation, because a testbench starts the counter at zero.
; On the board it returned nothing at all: hcpu_timer.v is a free-running
; counter matched for EQUALITY, and by the time a program has been flashed and
; shipped over the wire the counter is past forty million. A compare of 12
; would next be true after the 32-bit wrap -- about 157 seconds at 27 MHz.
; So the counter is read first and the deadline built from it. The fix is in
; the program, not the timer: equality against a counter nobody resets is
; exactly what makes a deadline relative rather than absolute.

        MOVI  R5, 0
        MOVI  R8, 0
        MOVI  R7, 0

        MOVI  R1, handler
        STORE R1, R5, 0xFF8     ; TRAP_VECTOR

        LOAD  R2, R5, 0xFF4     ; COUNTER — free-running, and NOT zero here
        ADDI  R2, R2, 12
        STORE R2, R5, 0xFF5     ; COMPARE — a deadline RELATIVE to now

        MOVI  R1, 1
        STORE R1, R5, 0xFFB     ; TRAP_ENABLE, timer only

; The loop the trap has to break into. Without the handler setting R8 this
; never leaves.
wait:   ADDI  R7, R7, 1
        CMPI  R8, 1
        JNE   wait

        HALT

; ── handler ─────────────────────────────────────────────────────
; It must clear its own source before ERET. The timer's expired flag is
; sticky, so returning with it still set traps again immediately — which is
; how every real interrupt controller behaves, and hiding it would only turn
; a visible spin into a lost interrupt.
handler:
        LOAD  R9,  R5, 0xFFA    ; TRAP_CAUSE  — the index, not a mask
        LOAD  R10, R5, 0xFF9    ; TRAP_EPC    — where it will return
        MOVI  R1, 0
        STORE R1, R5, 0xFF6     ; clear the timer status: the source goes low
        MOVI  R8, 1             ; tell the loop it may finish
        ERET
