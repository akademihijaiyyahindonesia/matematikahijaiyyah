// Tang Nano 20K HDMI wrapper constraints.
IO_LOC "clk_27m" 4;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33;
// S1 (Pin 88 = PIN88_MODE0_KEY1) and S2 (Pin 87 = PIN87_MODE1_KEY2):
// On the Tang Nano 20K (3921 schematic), both pins have external pull-down
// resistors to GND for boot mode strapping (MODE0=0, MODE1=0) and connect
// to +3.3V through 1 kOhm when pressed (active-HIGH). PULL_MODE=DOWN aligns
// the FPGA pad pull with the board's external pull-down.
IO_LOC "btn_rst_n" 87;
IO_PORT "btn_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "mode_key" 88;
IO_PORT "mode_key" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "uart_rxd" 70;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_txd" 69;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 DRIVE=8;
// Differential TMDS pairs (Candidate B, proven on Tang Nano 20K silicon):
// one IOB per lane, IO_TYPE=LVCMOS33D DRIVE=8, constrained on the positive pad
// (`33`, `35`, `37`, `39`) with `tmds_data_p[2:0]` mapped in standard Gowin/Sipeed
// lane order (`_2` -> pin 35, `_1` -> pin 37, `_O` -> pin 39).
IO_LOC "tmds_clk_p_OBUF_O" 33;
IO_PORT "tmds_clk_p_OBUF_O" IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_data_p_OBUF_O_2" 35;
IO_PORT "tmds_data_p_OBUF_O_2" IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_data_p_OBUF_O_1" 37;
IO_PORT "tmds_data_p_OBUF_O_1" IO_TYPE=LVCMOS33D DRIVE=8;
IO_LOC "tmds_data_p_OBUF_O" 39;
IO_PORT "tmds_data_p_OBUF_O" IO_TYPE=LVCMOS33D DRIVE=8;

IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;
// ── Onboard TF card, SDIO 1-bit ──────────────────────────────────
// The same six pins hcpu_gowin.cst names, from the Sipeed Tang Nano 20K
// 3921 schematic: PIN83_SDIO_CLK, PIN82_SDIO_CMD, PIN84_SDIO_D0,
// PIN85_SDIO_D1, PIN80_SDIO_D2, PIN81_SDIO_D3. Verified against the official
// schematic by the owner on 14 September 2026, and proved on the board the
// next day -- a card answered, was written, and kept its sector across a
// power cycle.
//
// They arrive here because hcpu_hdmi_top now connects them. Until M5 this
// wrapper instantiated the CPU with the card's pins dangling: the controller
// was in the slot and could not see a socket.
//
// CMD and DAT0 are open lines the controller releases so the card can answer;
// the board carries 10 kOhm pull-ups on all five data/command lines, so
// PULL_MODE=UP here is a second, weaker helper rather than the thing holding
// them high.
IO_LOC  "sd_clk"    83;
IO_PORT "sd_clk"    IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC  "sd_cmd"    82;
IO_PORT "sd_cmd"    IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sd_dat[0]" 84;
IO_PORT "sd_dat[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sd_dat[1]" 85;
IO_PORT "sd_dat[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sd_dat[2]" 80;
IO_PORT "sd_dat[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sd_dat[3]" 81;
IO_PORT "sd_dat[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
