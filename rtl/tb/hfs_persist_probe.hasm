; hfs_persist_probe.hasm — the same process, booted twice, with only the card between.
;
; Injected into a copy of the shell image as pid 0 by rtl/scripts/inject_probe.py,
; exactly as rtl/tb/hfs_syscall_probe.hasm is. The bench boots that image, and
; the same image is what stage 1's physical test bakes into the board: the
; owner's closing condition is CREATE, WRITE, power off, power on, READ the
; same -- and only a board can lose power.
;
; It asks one question first: does file 0 exist?
;
;   NO  -> first boot. CREATE file 0, WRITE Kaf into it, report phase 1.
;   YES -> a later boot. The vector READ returned must be Kaf: report phase 2
;          if it is, phase 3 if it is not.
;
; The bench boots it, resets the CPU, ZEROES THE WHOLE DATA RAM, and boots it
; again. Zeroing is not optional. hcpu_dataram.v clears its memory only in an
; `initial` block, not on reset, so without it the HFS table from the first boot
; would still be sitting at 0xE80 and the second boot would "find" file 0
; without ever reading the card -- a green result from the wrong cause. The
; board loses that RAM on power loss; the bench has to lose it on purpose.
;
; Writes, in its own window 0x100-0x1FF:
;   0x101  phase    1 written this boot, 2 found and equal, 3 found and wrong
;   0x102  HFS_CREATE result  (phase 1 only)
;   0x103  HFS_WRITE  result  (phase 1 only)
;   0x100  0x5A, written LAST
;
; And says the same on the wire, through syscall 1 `write`, because a board has
; no probe on its data RAM:
;   first boot    1  create  write      -- "1 1 1" when both reached the card
;   later boot    2                     -- or 3
; The shell's banner shares the wire and has no digit in it.

probe:  MOVI  R5, 0
        MOVI  R1, 7             ; HFS_READ file 0: does it exist?
        MOVI  R2, 0
        SYSCALL
        CMPI  R1, 1
        JEQ   p_found
        MOVI  R1, 6             ; first boot: HFS_CREATE
        MOVI  R2, 0
        SYSCALL
        STORE R1, R5, 0x102
        HLOAD H0, 22            ; Kaf, the only letter whose H* is 1
        MOVI  R1, 8             ; HFS_WRITE
        MOVI  R2, 0
        SYSCALL
        STORE R1, R5, 0x103
        MOVI  R2, 1             ; phase 1
        JMP   p_phase
p_found:
        HLOAD H1, 22            ; what the card must have given back
        CEQ   H0, H1
        JEQ   p_eq
        MOVI  R2, 3             ; found, but not what was written
        JMP   p_phase
p_eq:   MOVI  R2, 2             ; found, and equal
p_phase:
        STORE R2, R5, 0x101
        MOVI  R1, 1             ; write: the phase. R2 comes back untouched --
        SYSCALL                 ; the kernel returns a result in R1 only
        CMPI  R2, 1
        JNE   p_done
        LOAD  R2, R5, 0x102     ; a first boot also says what CREATE
        MOVI  R1, 1
        SYSCALL
        LOAD  R2, R5, 0x103     ; and WRITE answered
        MOVI  R1, 1
        SYSCALL
p_done: MOVI  R2, 0x5A
        STORE R2, R5, 0x100     ; done, written last
p_spin: JMP   p_spin
