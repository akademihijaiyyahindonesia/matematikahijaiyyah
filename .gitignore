# Yosys synthesis artifacts (large; regenerate with: cd rtl/mpw && yosys -s synth_hcpu.ys)
rtl/mpw/hcpu_synth.json
rtl/mpw/hcpu_synth_netlist.v

# Simulation artifacts (regenerate with: iverilog -g2012 -I rtl -o out.vvp rtl/tb/<tb>.v rtl/*.v)
*.vcd
*.vvp

# Program images the tb Makefile builds from .hasm. Named one by one: most of
# the .hex files beside them are checked-in test vectors, so a blanket *.hex
# would ignore the inputs the benches are validated against.
rtl/tb/program.hex
rtl/tb/loader.hex
rtl/tb/kernel.hex
rtl/tb/letters.hex
rtl/tb/subroutine.hex
rtl/tb/syscall_io.hex
rtl/tb/hos_demo.hex
rtl/tb/flags_ctx.hex
rtl/tb/hfs_lifecycle.hex
rtl/tb/sdio_write.hex
rtl/tb/sdio_verify.hex
rtl/tb/sdio_probe.hex
rtl/tb/trap_hreg.hex
rtl/tb/blank_text.hex
# Generated by rtl/scripts/gen_dashboard.py -- the screen layout and the
# addresses of its live fields, emitted together so they cannot drift.
#
# All three, not two. hcpu_display.hex is the display node's own layout and
# comes out of the same run (gen_dashboard.py writes it beside the other two);
# leaving it tracked would put a generated file under version control next to
# its generator, which is the second copy R1 exists to forbid. The Makefile
# rebuilds it: `$(RTL_DIR)/hcpu_display.hex: $(RTL_DIR)/scripts/gen_dashboard.py`.
#
# hcpu_font8x8.hex is NOT here and must not be: nothing generates it. It is
# authored source, 51 glyphs, and the repo is where it lives.
rtl/hcpu_dashboard.hex
rtl/hcpu_dashboard_pos.vh
rtl/hcpu_display.hex
rtl/tb/shell.hex
rtl/tb/payload.txt

# Naskah buku, dokumen paten, dan proposal — TIDAK dipublikasikan.
# Repo ini publik (GitHub Pages di hybit.tech), jadi isi folder ini sengaja
# ditahan di lokal. Cadangkan sendiri; git tidak menyimpannya.
# Renamed from 'Matematika Hijaiyyah/'. Both spellings stay ignored so a
# checkout with either name does not offer 25 MB of PDFs to git.
Matematika Hijaiyyah/
Buku Matematika Hijaiyyah/

# Coverage report emitted by the CI pytest invocation
coverage.xml

# Verilator lint output (regenerate with: python rtl/scripts/lint_hcpu.py)
rtl/lint_report_*.txt

# Vite dependency-optimisation cache
hom-gui/.vite/

# Vendored upstream three.js. hom-gui installs `three` from npm instead
# (see hom-gui/package.json), so this local copy is not part of the build.
three.js-master/
